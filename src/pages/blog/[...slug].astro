---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

const post = Astro.props;
const { Content } = await render(post);
---
<Layout title={`${post.data.title} | Furnace Repair Spring TX`} description={post.data.description}>
  <section class="section">
    <div class="container prose">
      <p style="color:var(--text-muted);margin-bottom:0.5rem">
        {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })} · {post.data.author}
      </p>
      <h1>{post.data.title}</h1>
      <Content />
      <div style="margin-top:3rem;padding-top:2rem;border-top:1px solid var(--border)">
        <a href="/blog/" style="color:var(--accent)">← Back to Blog</a>
      </div>
    </div>
  </section>
</Layout>
