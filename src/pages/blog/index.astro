---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<Layout title="Blog | Furnace Repair Spring TX" description="Tips, guides and advice for furnace care and heating in Spring, TX.">
  <section class="hero" style="padding:3rem 0">
    <div class="container">
      <div class="hero-badge">● TIPS & GUIDES</div>
      <h1 style="font-size:clamp(1.8rem,4vw,2.5rem)">Furnace Repair Blog</h1>
      <p class="hero-desc" style="max-width:600px">Practical advice for keeping your home warm and your furnace running efficiently in Spring, TX.</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="blog-grid">
        {posts.map((post) => (
          <a href={`/blog/${post.id}/`} class="blog-card" style="display:block">
            <div class="blog-card-body">
              <h3>{post.data.title}</h3>
              <div class="meta">{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })} · {post.data.author}</div>
              <p>{post.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
