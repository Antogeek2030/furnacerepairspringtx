---
const phone = '+12815550199';
const phoneDisplay = '(281) 555-0199';
const currentPath = Astro.url.pathname;
---
<header class="header">
  <div class="container header-inner">
    <a href="/" class="logo">
      <span class="logo-icon">🔥</span>
      <span class="logo-text">Furnace Repair<br /><small>Spring, TX</small></span>
    </a>
    <nav class="nav" id="nav">
      <a href="/" class={currentPath === '/' || currentPath === '' ? 'active' : ''}>Home</a>
      <div class="dropdown">
        <button class="dropdown-toggle" aria-expanded="false">Our Services <span class="caret">▾</span></button>
        <div class="dropdown-menu">
          <a href="/services/emergency-furnace-repair/">Emergency Furnace Repair</a>
          <a href="/services/gas-furnace-repair/">Gas Furnace Repair</a>
          <a href="/services/electric-furnace-repair/">Electric Furnace Repair</a>
          <a href="/services/furnace-installation/">Furnace Installation</a>
          <a href="/services/furnace-maintenance/">Furnace Tune-Up &amp; Maintenance</a>
          <a href="/services/thermostat-repair/">Thermostat Repair</a>
        </div>
      </div>
      <div class="dropdown">
        <button class="dropdown-toggle" aria-expanded="false">Problems <span class="caret">▾</span></button>
        <div class="dropdown-menu">
          <a href="/problems/no-heat/">No Heat</a>
          <a href="/problems/strange-noises/">Strange Noises</a>
          <a href="/problems/short-cycling/">Short Cycling</a>
          <a href="/problems/uneven-heating/">Uneven Heating</a>
          <a href="/problems/high-energy-bills/">High Energy Bills</a>
          <a href="/problems/pilot-light-issues/">Pilot Light Issues</a>
        </div>
      </div>
      <a href="/service-areas/">Service Areas</a>
      <a href="/blog/">Blog</a>
      <a href="/about/">About Us</a>
      <a href="/contact/">Contact</a>
    </nav>
    <a href={`tel:${phone}`} class="header-phone">
      <span>📞</span>
      <span class="phone-text">{phoneDisplay}</span>
    </a>
    <button class="mobile-toggle" id="menuBtn" aria-label="Menu">☰</button>
  </div>
</header>
<script>
  const btn = document.getElementById('menuBtn');
  const nav = document.getElementById('nav');
  btn?.addEventListener('click', () => nav?.classList.toggle('open'));
  document.querySelectorAll('.dropdown-toggle').forEach(toggle => {
    toggle.addEventListener('click', (e) => {
      e.preventDefault();
      const parent = toggle.closest('.dropdown');
      const isOpen = parent?.classList.contains('open');
      document.querySelectorAll('.dropdown').forEach(d => d.classList.remove('open'));
      if (!isOpen) parent?.classList.add('open');
    });
  });
  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('.dropdown')) {
      document.querySelectorAll('.dropdown').forEach(d => d.classList.remove('open'));
    }
  });
</script>
